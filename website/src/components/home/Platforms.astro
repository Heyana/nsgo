const words = allWords[lang];

// Where each tile sits, in points of a 480 by 300 board, and the shape of
// the device or surface it runs on. The board has three columns, desktops,
// phones and the rest, with 12 points between every tile; the desktops and
// the phones share their three rows.
type Shape = 'window' | 'browser' | 'phone' | 'clip' | 'watch' | 'tv' | 'capsule';
const tiles: Record<string, { shape: Shape; x: number; y: number; w: number; h: number; controls?: 'left' | 'right' }> = {
  macOS: { shape: 'window', controls: 'left', x: 0, y: 0, w: 156, h: 92 },
  Windows: { shape: 'window', controls: 'right', x: 0, y: 104, w: 156, h: 92 },
  Linux: { shape: 'window', controls: 'right', x: 0, y: 208, w: 156, h: 92 },
  iOS: { shape: 'phone', x: 168, y: 0, w: 72, h: 92 },
  HarmonyOS: { shape: 'phone', x: 168, y: 104, w: 72, h: 92 },
  Android: { shape: 'phone', x: 168, y: 208, w: 72, h: 92 },
  tvOS: { shape: 'tv', x: 252, y: 0, w: 148, h: 84 },
  watchOS: { shape: 'watch', x: 412, y: 0, w: 68, h: 92 },
  'App Clips': { shape: 'clip', x: 254, y: 106, w: 88, h: 88 },
  Web: { shape: 'browser', x: 356, y: 104, w: 124, h: 92 },
  WeChat: { shape: 'capsule', x: 252, y: 208, w: 108, h: 40 },
  QQ: { shape: 'capsule', x: 372, y: 208, w: 108, h: 40 },
  Alipay: { shape: 'capsule', x: 252, y: 260, w: 108, h: 40 },
  Douyin: { shape: 'capsule', x: 372, y: 260, w: 108, h: 40 },
};
---

<HeroField />

<div class="board">
  <ul class="tiles" aria-label={words.runsOn}>
    {platforms.map((platform, index) => {
      const tile = tiles[platform.name]!;
      return (
        <li
          class:list={['tile', `tile--${tile.shape}`, tile.controls && `tile--controls-${tile.controls}`]}
          style={`--i: ${index}; --x: ${tile.x}; --y: ${tile.y}; --w: ${tile.w}; --h: ${tile.h}`}
          tabindex={platform.experimental ? 0 : undefined}
          aria-describedby={platform.experimental ? `tile-tip-${index}` : undefined}
        >
          <Icon name={platform.icon} size={18} />
          <span class="tile__name">
            {platformName(platform, lang)
              .split(/(?=OS$)/)
              .map((part, i) => (i ? <><wbr />{part}</> : part))}
          </span>
          {platform.experimental && (
            <>
              <span class="tile__mark" />
              <span class="tile__tip" role="tooltip" id={`tile-tip-${index}`}>
                {platform.kind === 'mini' ? words.experimental : words.preview}
              </span>
            </>
          )}
        </li>
      );
    })}
  </ul>
  <div class="board__lines" aria-hidden="true">
    {platforms.map((platform) => (
      <p class="board__line">
        <strong>{platformName(platform, lang)}</strong>{words.drawsWith[0]}<span>{platform.stack}</span>{words.drawsWith[1]}
      </p>
    ))}
  </div>
</div>

<script>
  // The platforms take turns being lit, with the line under them naming
  // what draws the lit one. Pointing at one lights and holds it; the turns
  // stop when the reader asked for less motion.
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('.tile'));
  const lines = Array.from(document.querySelectorAll<HTMLElement>('.board__line'));
  let lit = 0;
  let held = false;
  const light = (index: number) => {
    tiles.forEach((tile, i) => tile.classList.toggle('is-lit', i === index));
    lines.forEach((line, i) => line.classList.toggle('is-lit', i === index));
  };
  tiles.forEach((tile, index) => {
    tile.addEventListener('pointerenter', () => {
      held = true;
      lit = index;
      light(index);
    });
    tile.addEventListener('pointerleave', () => (held = false));
  });
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    light(lit);
  } else {
    window.setTimeout(() => {
      light(lit);
      window.setInterval(() => {
        if (held) return;
        lit = (lit + 1) % tiles.length;
        light(lit);
      }, 2200);
    }, 900);
  }
</script>
