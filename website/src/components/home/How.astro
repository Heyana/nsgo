    nodes: [
      { label: 'Aplikasi Anda', title: 'Go atau TSX', items: ['Komponen', 'Sinyal', 'Gaya dan Tailwind'] },
      { label: 'Mesin NSGo', title: 'Dalam Go', items: ['Graf reaktif', 'Flexbox dan grid', 'Persiapan teks'] },
      { label: 'Platform', title: 'Tampilan native', items: ['AppKit · UIKit', 'Android Views', 'Direct2D · GTK · DOM'] },
    ],
    links: ['merender', 'satu batch per commit'],
  },
  tr: {
    eyebrow: 'Nasıl çalışır',
    title: 'Uygulamayı Go yönetir. Platform çizer.',
    text: 'Uygulamanız ile ekran arasında gömülü bir tarayıcı veya özel bir çizici yoktur: her güncelleme ana iş parçacığına yalnızca bir kez, sadece değişenleri içeren tek bir yığın olarak geçer.',
    nodes: [
      { label: 'Uygulamanız', title: 'Go veya TSX', items: ['Bileşenler', 'Sinyaller', 'Stiller ve Tailwind'] },
      { label: 'NSGo motoru', title: 'Go ile', items: ['Reaktif grafik', 'Flexbox ve grid', 'Metin hazırlama'] },
      { label: 'Platform', title: 'Yerel görünümler', items: ['AppKit · UIKit', 'Android Views', 'Direct2D · GTK · DOM'] },
