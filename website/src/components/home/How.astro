    nodes: [
      { label: 'Votre app', title: 'Go ou TSX', items: ['Composants', 'Signaux', 'Styles et Tailwind'] },
      { label: 'Moteur NSGo', title: 'En Go', items: ['Graphe réactif', 'Flexbox et grid', 'Préparation du texte'] },
      { label: 'La plateforme', title: 'Vues natives', items: ['AppKit · UIKit', 'Android Views', 'Direct2D · GTK · DOM'] },
