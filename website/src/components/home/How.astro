    nodes: [
      { label: 'Deine App', title: 'Go oder TSX', items: ['Komponenten', 'Signale', 'Styles und Tailwind'] },
      { label: 'NSGo-Engine', title: 'In Go', items: ['Reaktiver Graph', 'Flexbox und Grid', 'Textvorbereitung'] },
