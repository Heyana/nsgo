  },
  vi: {
    eyebrow: 'Cách hoạt động',
    title: 'Go điều khiển ứng dụng. Nền tảng đảm nhiệm vẽ giao diện.',
    text: 'Không có trình duyệt nhúng hay bộ dựng hình tùy biến nào giữa ứng dụng và màn hình: mỗi lần cập nhật chỉ qua luồng chính một lần dưới dạng một lô duy nhất chứa đúng phần thay đổi.',
    nodes: [
      { label: 'Ứng dụng của bạn', title: 'Go hoặc TSX', items: ['Thành phần', 'Signal', 'Kiểu dáng và Tailwind'] },
      { label: 'Động cơ NSGo', title: 'Viết bằng Go', items: ['Đồ thị phản ứng', 'Flexbox và grid', 'Chuẩn bị văn bản'] },
      { label: 'Nền tảng', title: 'Giao diện gốc', items: ['AppKit · UIKit', 'Android Views', 'Direct2D · GTK · DOM'] },
