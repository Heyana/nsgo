const how = allHow[asSiteLang(Astro.props.lang)];
---

<section class="section" id="how">
  <div class="container">
    <SectionHead eyebrow={how.eyebrow} title={how.title} text={how.text} />
    <ol class="flow">
      {how.nodes.map((node, index) => (
        <>
          <li class:list={['flow__node', { 'flow__node--engine': index === 1 }]}>
            <span class="flow__label">{node.label}</span>
            <strong>{node.title}</strong>
            <ul>
              {node.items.map((item) => <li>{item}</li>)}
            </ul>
          </li>
          {index < how.links.length && (
            <li class="flow__link" aria-hidden="true">
              <span class="flow__track"><i></i><i></i><i></i></span>
              <span class="flow__caption">{how.links[index]}</span>
            </li>
          )}
        </>
      ))}
    </ol>
  </div>
</section>
