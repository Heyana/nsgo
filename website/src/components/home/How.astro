    nodes: [
      { label: 'Ваше приложение', title: 'Go или TSX', items: ['Компоненты', 'Сигналы', 'Стили и Tailwind'] },
      { label: 'Движок NSGo', title: 'На Go', items: ['Реактивный граф', 'Flexbox и grid', 'Подготовка текста'] },
      { label: 'Платформа', title: 'Нативные компоненты', items: ['AppKit · UIKit', 'Android Views', 'Direct2D · GTK · DOM'] },
    ],
    links: ['рендерит', 'один пакет на коммит'],
  },
  it: {
    eyebrow: 'Come funziona',
    title: 'Go gestisce l’app. La piattaforma la disegna.',
    text: 'Nessun browser integrato e nessun renderer personalizzato tra la tua app e lo schermo: ogni aggiornamento passa al thread principale una sola volta, in un unico batch con solo ciò che è cambiato.',
    nodes: [
      { label: 'La tua app', title: 'Go o TSX', items: ['Componenti', 'Segnali', 'Stili e Tailwind'] },
      { label: 'Motore NSGo', title: 'In Go', items: ['Grafo reattivo', 'Flexbox e grid', 'Preparazione del testo'] },
      { label: 'La piattaforma', title: 'Viste native', items: ['AppKit · UIKit', 'Android Views', 'Direct2D · GTK · DOM'] },
    ],
