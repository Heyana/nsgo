    links: ['渲染', '每次提交一批'],
  },
  'zh-tw': {
    eyebrow: '運作原理',
    title: 'Go 掌管應用，平台負責繪製',
    text: '應用與螢幕之間沒有內嵌瀏覽器，也沒有自繪算繪器：每次更新只跨越主執行緒一次，單一批次僅傳遞變動部分。',
    nodes: [
      { label: '你的應用', title: 'Go 或 TSX', items: ['元件', 'signal', '樣式與 Tailwind'] },
      { label: 'NSGo 引擎', title: '執行於 Go', items: ['響應式圖', 'flexbox 與 grid', '文字準備'] },
