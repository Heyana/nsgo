{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run",
      "type": "process",
      "command": "go",
      "args": [
        "tool",
        "nsgo",
        "dev",
        "examples/gallery"
      ],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest"
      },
      "problemMatcher": "$go"
    },
    {
      "label": "build",
      "type": "process",
      "command": "go",
      "args": [
        "tool",
        "nsgo",
        "build",
        "examples/gallery"
      ],
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "terminateOldest"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$go"
    }
  ]
}
