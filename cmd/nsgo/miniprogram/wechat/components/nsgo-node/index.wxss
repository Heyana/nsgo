/* Every view sits at the frame NSGo laid it out at, in its parent's
   padding box. */
.n {
  position: absolute;
  box-sizing: border-box;
  margin: 0;
}
.content {
  position: relative;
}
/* Lines are placed where NSGo measured them: the render layer never
   wraps. */
.line {
  position: absolute;
  white-space: pre;
}
.span-background {
  position: absolute;
  pointer-events: none;
}
/* A text field sits in its content box. */
.field {
  position: absolute;
  min-height: 0;
  padding: 0;
  margin: 0;
  background: transparent;
}
/* A canvas's picture and an image fill their view, under its children. */
.fill {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.pixel-clip {
  overflow: hidden;
  border-radius: inherit;
}
.pixel-canvas {
  position: absolute;
}
.tint-source {
  opacity: 0;
  pointer-events: none;
}
.tint-mask {
  overflow: hidden;
  border-radius: inherit;
  pointer-events: none;
}
.sel-rect {
  position: absolute;
  pointer-events: none;
}
.sel-handle {
  position: absolute;
  z-index: 2;
}
.sel-bar {
  position: absolute;
  left: 13px;
  top: 14px;
  width: 2px;
  pointer-events: none;
}
.sel-knob {
  position: absolute;
  left: 8px;
  width: 12px;
  height: 12px;
  border-radius: 6px;
  pointer-events: none;
}
.sel-knob-top {
  top: 3px;
}
.sel-knob-bottom {
  bottom: 3px;
}
